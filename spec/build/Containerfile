# Build environment for NetworkManager's own settings-documentation generator.
#
# The types of connection-profile properties exist nowhere machine-readable in NetworkManager's
# git tree: they are derived from GObject introspection data, which only exists once libnm has
# been compiled. This image compiles just enough of NetworkManager at a release tag to run that
# generator, so `spec/nm-settings-docs-dbus.xml` can be committed and everything downstream --
# including anyone depending on nm-automata -- stays pure Rust with no C toolchain.
FROM fedora:43

RUN dnf install -y --setopt=install_weak_deps=False \
        dnf-plugins-core git meson ninja-build gcc \
    && dnf builddep -y --setopt=install_weak_deps=False NetworkManager \
    && dnf clean all

COPY build-settings-spec.sh /usr/local/bin/build-settings-spec
ENTRYPOINT ["/usr/local/bin/build-settings-spec"]
